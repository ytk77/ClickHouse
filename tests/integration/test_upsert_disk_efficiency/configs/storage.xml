<clickhouse>
    <!-- This policy applies to every case in the module, including rewrite outputs. -->
    <compression>
        <case>
            <min_part_size>16384</min_part_size>
            <min_part_size_ratio>0</min_part_size_ratio>
            <method>zstd</method>
            <level>1</level>
        </case>
    </compression>
    <storage_configuration>
        <disks>
            <limited>
                <type>local</type>
                <path>/upsert_disk_efficiency/</path>
            </limited>
        </disks>
        <policies>
            <limited>
                <volumes>
                    <main><disk>limited</disk></main>
                </volumes>
            </limited>
        </policies>
    </storage_configuration>
</clickhouse>
